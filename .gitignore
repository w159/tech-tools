!.atlas/memory/**
!.atlas/nudge/
!.atlas/nudge/**
!.atlas/CLAUDE.md
!.atlas/AGENTS.md


# ============================================================================
# SECTION 5 — Re-exclude generated, local, and machine-specific artifacts
# MUST physically appear after all allowlist (!) rules — later rules win.
# ============================================================================

# ---- Node / TypeScript build outputs ----
**/node_modules/
**/node_modules/**
**/node_modules.nosync.noindex/
**/node_modules.nosync.noindex/**
**/node_modules.nosync.noindex

# ---- Atlas ephemeral run state (orchestration scratch; never durable) ----
# docs/ never carries a .run/ subtree (that lives under .atlas/.run/ only), but
# this stays as belt-and-suspenders in case a legacy layout re-creates one.
docs/.run/
docs/.run/**
# .atlas/.run/ is ephemeral scratch EXCEPT the findings.json ledger, which is
# the durable verification record the Law 5 gate reads and must ship with the
# repo. The directory itself must be explicitly re-included (!.atlas/.run/)
# before a per-file negation inside it can take effect -- git will not
# re-include a file whose parent directory is excluded, even by a later rule.
!.atlas/.run/
.atlas/.run/*
!.atlas/.run/findings.json

# ---- Safety: keep any nested git repo / vendored doc-site clone under docs/ out ----
# The docs allowlist above never includes these; this is belt-and-suspenders so a
# future blanket !docs/** can never drag a gigabyte of nested .git repos into history.
docs/**/.git/
docs/**/.git/**

**/dist/
**/dist/**
**/build/
**/build/**
**/.next/
**/.nuxt/
**/.turbo/
**/.vite/
**/.cache/
**/*.tsbuildinfo
**/coverage/
**/coverage/**
**/.eslintcache

# ---- atlas MCP servers: bundled, must ship trackable ----
# Each vendor ships as a single self-contained plugins/atlas/mcp/<key>/server.mjs
# (tsup noExternal bundle, no dist/, no node_modules/). These MUST be tracked:
# the previous .mcpb bundles were ignored, so marketplace installs shipped
# launchers with nothing to launch and every server was dead on arrival.
# Re-included after the generic dist/ and node_modules/ excludes above.
!plugins/atlas/mcp/
!plugins/atlas/mcp/**

# ---- Generated knowledge-graph output (graphify skill) ----
# These cache files embed absolute /Users/<name>/... paths — never commit them.
**/graphify-out/
**/graphify-out/**

# ---- Downloaded / auto-generated archives ----
mcp_servers/*.zip
mcp_servers/**/*.zip

# ---- MCP server archive folder (historical snapshots, not source) ----
mcp_servers/.archive/
mcp_servers/.archive/**

# ---- Per-project env re-exclusions ----
# The broad !mcp_servers/** above would un-ignore .env files; these lines
# re-exclude all .env variants across every subdirectory at any depth.
**/.env
**/.env.*
# Re-preserve safe template / example variants after the broad .env.* sweep:
!**/.env.template
!**/.env.example
!**/.env.sample

# ---- plugins/atlas real env file: never tracked, template stays tracked ----
plugins/atlas/.env
!plugins/atlas/.env.example

# ---- Claude Desktop config (may contain API keys / session tokens) ----
**/.claude/
**/.claude/**

# ---- Log files ----
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- OS / editor noise ----
**/.DS_Store
**/.DS_Store/**
.DS_Store
Thumbs.db
desktop.ini
**/.idea/
**/.vscode/
!**/.vscode/settings.json.example
**/*.swp
**/*.swo

# ---- Python baseline (not in active use; kept for hostile-default coverage) ----
**/__pycache__/
**/__pycache__/**
**/*.py[cod]
**/.venv/
**/venv/
**/.pytest_cache/
**/.pytest_cache/**
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
.coverage

# ---- Atlas runtime state must never be tracked (written by hooks at runtime) ----
**/.atlas_nudge
plugins/atlas/**/.claude/.atlas_nudge
**/__pycache__/
**/.ruff_cache/
**/.in_use/
**/.in_use/**


# ============================================================================
# Pre-commit verification checklist:
#   1. git status                                 # nothing unexpected staged?
#   2. git check-ignore -v .env                   # confirm secrets are ignored
#   3. confirm no secret-shaped file is tracked (matches the terminal
#      re-exclusion block at the end of this file, not just env/key/pem):
#      git ls-files | grep -iE '\.(env|key|pem|p12|pfx|pkcs12|crt|cer|der|asc|gpg|jks|keystore|ppk|p8|kdbx|ovpn|jwt|token|tfstate|sql|dump|bak)$|(^|/)(id_[a-z]+|authorized_keys|known_hosts|secrets\.(json|ya?ml)|credentials\.(json|ya?ml)|\.netrc|\.npmrc|\.pypirc|\.pgpass|\.boto|\.s3cfg|\.htpasswd|\.git-credentials)$'
#      Expected: nothing, except the one documented .sql carve-out.
#   4. git diff --cached                          # review staged content
# If ANY secret-like file appears in steps 1, 3, or 4, STOP and investigate.
# ============================================================================

# Built MCPB bundles in mcp_servers/ are NOT tracked (rebuilt locally / shipped via Releases).
*.mcpb
# EXCEPTION: connector bundles shipped INSIDE a plugin are tracked on purpose.
# Each MUST stay small (~3 MB): the slimmed pack excludes the dev toolchain and
# the iCloud node_modules.nosync.noindex twin (see mcp_servers/_shared/pack-mcpb.js).
# A bundle that balloons to tens of MB means the pack regressed - a marketplace
# fetch then stalls, and any single file over GitHub's 100 MB hard limit rejects
# the whole push. Re-pack with the canonical packer before committing; never
# commit a multi-tens-of-MB .mcpb. The plugin extracts each bundle to
# ${CLAUDE_PLUGIN_DATA} on first run, which is what makes connectors work after a
# marketplace install. Later rules win, so this re-include must stay after the
# *.mcpb exclusion above.
!plugins/*/mcp/*.mcpb
.orchestrator/
.fallow/

# =====================================================================
# GLOBAL SECRET RE-EXCLUSION -- MUST BE THE LAST RULES IN THIS FILE
# =====================================================================
# Why this exists: the secret patterns in Section 3 (lines ~66-120) are
# negated by every later `!docs/<subdir>/**`, `!.atlas/<subdir>/**` and
# `!plugins/**` allowlist rule, because last matching rule wins. Before this
# block, `git check-ignore` proved these were all TRACKABLE:
#   docs/decisions/id_rsa   docs/audits/secret.key   docs/specs/id_rsa
#   docs/decisions/foo.pem  docs/decisions/credentials.json
# Only .env was safe, via its own post-allowlist **/.env rule.
#
# This mirrors Section 3's full vocabulary, plus shapes an adversarial audit
# found still open. NOTHING may be added below this block: any `!` rule placed
# after it wins and silently reopens the hole for that subtree.
#
# Deliberately NOT included, and why:
#   **/config.json -- too broad; it would block legitimate application config
#     throughout the tree. Review config.json files by hand for credentials.
#   **/*.sql -- .sql is a SOURCE type in this repo, not just a dump format
#     (plugins/atlas/skills/atlas-db-audit/scripts/read-only-catalog-queries.sql
#     is tracked). Blocking it here would silently ignore new query scripts.
#     Section 3's root-level *.sql still catches dumps outside allowlisted dirs.

# Keys and certs (mirrors Section 3)
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.pkcs12
**/*.crt
**/*.cer
**/*.der
**/*.asc
**/*.gpg
**/*.jks
**/*.keystore
**/*.ppk
**/*.p8

# SSH material
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/*_rsa
**/*_dsa
**/*_ecdsa
**/*_ed25519
**/authorized_keys
**/known_hosts

# Generic secret markers (mirrors Section 3)
**/*.secret
**/*.secrets
**/secrets.json
**/secrets.yaml
**/secrets.yml
**/credentials.json
**/credentials.yaml
**/credentials.yml
**/secrets/

# Cloud / provider credentials (mirrors Section 3)
**/gcloud-key.json
**/service-account*.json
**/*serviceaccount*.json
**/firebase-adminsdk*.json

# Tokens, sessions, password stores
**/.netrc
**/.npmrc
**/.pypirc
**/.terraformrc
**/.pgpass
**/.boto
**/.s3cfg
**/.htpasswd
**/.git-credentials
**/*.kdbx
**/*.ovpn
**/*.jwt
**/*.token
**/*.tfstate
**/*.tfstate.*

# Dump / backup leaks (mirrors Section 3)
# *.sql is blanket-blocked: a DB dump in an allowlisted folder is the exact leak
# this block exists to stop (db_dump.sql, prod_backup.sql, customers_dump.sql
# were all trackable while this pattern was omitted). The repo does track one
# legitimate .sql source file, so it gets a single named negation right here --
# inside the terminal block, never below it. Add further carve-outs the same way:
# named path, immediately after the pattern it excepts.
**/*.sql
!plugins/atlas/skills/atlas-db-audit/scripts/read-only-catalog-queries.sql
**/*.dump
**/*.bak
# Binary dump and embedded-DB shapes an adversarial probe found still trackable
# inside allowlisted folders on 2026-08-06 (git check-ignore said TRACKABLE for
# every one of these under docs/decisions/): a Postgres custom-format dump, an
# Oracle/Windows .dmp, a Redis snapshot, an Azure SQL .bacpac, and a raw SQLite
# file. No tracked file in this repo matches any of them (verified with
# `git ls-files`), so nothing legitimate is lost by blanket-blocking them.
**/*.pgdump
**/*.dmp
**/*.rdb
**/*.bacpac
**/*.sqlite
**/*.sqlite3
**/*.db

# Key material the probe also found trackable: a Java keystore variant, a
# Kerberos keytab, and a PKCS#7 certificate bundle.
**/*.jceks
**/*.keytab
**/*.p7b
