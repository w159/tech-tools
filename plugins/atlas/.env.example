# Committed template - copy to plugins/atlas/.env and fill in real values.
# .env values here take precedence over Claude Code's ${user_config.*} plugin settings
# (so an installed copy CAN be configured through user_config entries instead - both
# paths are valid, this file is just the source-tree one).
#
# WHERE AN INSTALLED COPY READS CREDENTIALS: .mcp.json sets
# ATLAS_ENV_FILE=${CLAUDE_PLUGIN_ROOT}/.env for every connector. For an installed
# plugin CLAUDE_PLUGIN_ROOT is the plugin cache, and a cache does not carry a .env,
# so that path resolves to nothing. Two supported ways to configure an installed
# copy: set ATLAS_ENV_FILE to the absolute path of a real env file (plugin MCP server
# env or the enclosing settings), or set the per-vendor keys through user_config.
# A .env written INTO the cache is lost on the next plugin update.
#
# TWO FAILURE SHAPES - do not conflate them:
#   * missing-var / "NOT CONFIGURED"  -> the env file the server actually reads is
#     absent or incomplete. The status tools list the exact keys at fault.
#   * 400 "Invalid Token" / TOKEN_REVOKED with keys present -> the key itself is
#     stale or revoked (ThreatLocker requires a portal reissue; no env edit fixes it).
# ConnectWise requires all four: COMPANY_ID, CLIENT_ID, PUBLIC_KEY, PRIVATE_KEY.
# NinjaOne also reads NINJAONE_REGION and NINJAONE_AUTH_MODE.

# ConnectWise Manage (PSA) API credentials
# CW_MANAGE_COMPANY_ID=
# CW_MANAGE_PUBLIC_KEY=
# CW_MANAGE_PRIVATE_KEY=
# CW_MANAGE_CLIENT_ID=
# CW_MANAGE_URL=

# Auvik (IT operations / network monitoring)
# AUVIK_USERNAME=
# AUVIK_API_KEY=
# AUVIK_REGION=

# Blumira (security / SIEM)
# BLUMIRA_JWT_TOKEN=
# BLUMIRA_CLIENT_ID=
# BLUMIRA_CLIENT_SECRET=
# BLUMIRA_BASE_URL=

# CIPP (Microsoft 365 / CyberDrain Improved Partner Portal)
# CIPP_BASE_URL=
# CIPP_API_KEY=
# CIPP_TENANT_ID=
# CIPP_CLIENT_ID=
# CIPP_CLIENT_SECRET=

# Kaseya Spanning (cloud backup)
# SPANNING_ADMIN_EMAIL=
# SPANNING_API_TOKEN=
# SPANNING_PLATFORM=
# SPANNING_API_URL=

# CrowdStrike Falcon (security / EDR)
# FALCON_CLIENT_ID=
# FALCON_CLIENT_SECRET=
# FALCON_BASE_URL=
# FALCON_MEMBER_CID=

# KnowBe4 (security awareness training)
# KNOWBE4_API_KEY=
# KNOWBE4_REGION=
# KNOWBE4_BASE_URL=

# NinjaOne (RMM / IT operations)
# NINJAONE_CLIENT_ID=
# NINJAONE_CLIENT_SECRET=
# NINJAONE_REGION=
# NINJAONE_AUTH_MODE=
# NINJAONE_BASE_URL=

# Paylocity (HR / payroll)
# PAYLOCITY_CLIENT_ID=
# PAYLOCITY_CLIENT_SECRET=
# PAYLOCITY_COMPANY_ID=
# PAYLOCITY_BASE_URL=
# PAYLOCITY_SANDBOX=

# ThreatLocker (security / endpoint control)
# THREATLOCKER_API_KEY=
# THREATLOCKER_ORGANIZATION_ID=
# Instance letter is in your portal URL (portal.<x>.threatlocker.com). Blank assumes g, which is not universal.
# THREATLOCKER_BASE_URL=https://portalapi.h.threatlocker.com/portalapi

# Vanta (security / compliance)
# VANTA_CLIENT_ID=
# VANTA_CLIENT_SECRET=
# VANTA_BASE_URL=
