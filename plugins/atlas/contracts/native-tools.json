{
  "_doc": "Single source for atlas native-tool routing and the delegation-mandate exemption. Read by hooks/dispatch_tripwire.py, hooks/completion_gate.py (Claude Code) and omp/contracts.ts -> omp/index.ts (omp). Reachability and message wording stay per harness (the call mechanism differs); WHAT is denied or nudged, toward WHICH replacement, lives here.",
  "delegationExempt": {
    "dirs": [
      "docs",
      ".atlas"
    ],
    "extensions": [
      ".md"
    ]
  },
  "ompToolStateDirs": [".serena", ".lean-ctx", ".context-mode", ".fallow", ".supermemory", ".taskmaster", ".scratch", ".agents"],
  "kinds": {
    "search": {
      "claude": "Grep",
      "omp": "grep",
      "mode": "deny",
      "replacements": [
        {
          "tool": "ctx_search",
          "servers": [
            "lean-ctx"
          ]
        }
      ]
    },
    "glob": {
      "claude": "Glob",
      "omp": "glob",
      "mode": "deny",
      "replacements": [
        {
          "tool": "ctx_glob",
          "servers": [
            "lean-ctx"
          ]
        }
      ]
    },
    "read": {
      "claude": "Read",
      "omp": "read",
      "mode": "nudge",
      "replacements": [
        {
          "tool": "ctx_read",
          "servers": [
            "lean-ctx"
          ]
        }
      ]
    },
    "shell": {
      "claude": "Bash",
      "omp": "bash",
      "mode": "nudge",
      "replacements": [
        {
          "tool": "ctx_shell",
          "servers": [
            "lean-ctx"
          ]
        },
        {
          "tool": "ctx_execute",
          "servers": [
            "lean-ctx",
            "context-mode"
          ]
        }
      ]
    }
  },
  "explorationShell": {
    "_doc": "Bash is exploration-only (denied toward ctx_* when lean-ctx is reachable) when EVERY segment of the command, split on && || ; |, after optional leading `cd x &&` segments, starts with one of `commands` (basename), plus `sed -n` and `awk`, AND nothing writes: no `>` anywhere (after first stripping fd duplications like `2>&1` / `1>&2` and redirects to /dev/null like `2>/dev/null`, `>/dev/null`, `&>/dev/null`, which write nothing), no `tee`, no -delete/-exec/-execdir token, no -i* arg on a sed/awk segment. Algorithm lives in omp/contracts.ts isExplorationShell and hooks/dispatch_tripwire.py _is_exploration_shell; both iterate `cases`. Every ambiguous parse (quoted operators) falls to NOT exploration = allow.",
    "commands": [
      "cat",
      "head",
      "tail",
      "less",
      "more",
      "grep",
      "rg",
      "ag",
      "find",
      "fd",
      "ls",
      "tree",
      "wc",
      "stat",
      "file"
    ],
    "cases": {
      "deny": [
        "cat README.md",
        "head -20 src/app.py",
        "tail -n 5 app.log",
        "less /var/log/system.log",
        "grep -rn TODO src/",
        "grep -i warn app.log",
        "rg 'def main' .",
        "ag pattern lib/",
        "ls -la src",
        "find plugins -name '*.py'",
        "fd todo.txt",
        "tree -L 2 docs",
        "wc -l hooks/*.py",
        "stat package.json",
        "file build/out.zip",
        "sed -n '1,50p' NOTES.md",
        "awk '{print $1}' data.csv",
        "cd plugins/atlas && ls",
        "cat a.txt | grep err | wc -l",
        "cd /tmp && head -3 log && tail -3 log",
        "ls -la .atlas/.run 2>&1; cat .atlas/.run/findings.json 2>&1 | head -40",
        "cat a 2>&1",
        "grep -rn x . 2>/dev/null",
        "cat a >/dev/null",
        "find . -name '*.py' &>/dev/null",
        "ls 2>&1 >/dev/null",
        "tail -3 log 1>&2"
      ],
      "allow": [
        "python3 -m pytest hooks/test_dispatch_tripwire.py -q",
        "bun test plugins/atlas/omp/contracts.test.ts",
        "npm run build",
        "node -e \"console.log(1)\"",
        "git status --short",
        "cat notes > out.txt",
        "cat a 2>err.log",
        "cat a 2>1",
        "ls > /dev/nullx",
        "ls &>out.txt",
        "cat a 2>&1 > out.txt",
        "cat a 2>&1 >> out.txt",
        "cat a 2>/dev/null > out.txt",
        "cat notes >> out.txt",
        "grep x f | tee out.txt",
        "sed -i 's/a/b/' f",
        "sed 's/a/b/' f",
        "awk -i inplace '{print $1}' f",
        "find . -name '*.tmp' -delete",
        "find . -name '*.log' -exec rm {} \\;",
        "cat a && npm test",
        "python3 gen.py > gen.log",
        "grep 'a && b' file | wc -l",
        "curl -s http://example.com/api | cat",
        "mkdir -p dist/assets",
        "rm -rf build/",
        "docker ps"
      ]
    }
  },
  "delegationExemptCases": {
    "exempt": [
      "docs/CHANGELOG.md",
      "README.md",
      ".atlas/run.json",
      "plugins/x/docs/guide.txt",
      "sub/.atlas/state.json"
    ],
    "code": [
      "src/app.py",
      "plugins/atlas/omp/index.ts",
      "docsite/app.ts",
      "notes.mdx"
    ]
  }
}
