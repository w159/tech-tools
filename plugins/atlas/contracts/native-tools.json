{
  "_doc": "Single source for atlas native-tool routing and the delegation-mandate exemption. Read by hooks/dispatch_tripwire.py, hooks/completion_gate.py (Claude Code) and omp/contracts.ts -> omp/index.ts (omp). Reachability and message wording stay per harness (the call mechanism differs); WHAT is denied or nudged, toward WHICH replacement, lives here.",
  "delegationExempt": {
    "dirs": [
      "docs",
      ".atlas"
    ],
    "extensions": [
      ".md"
    ]
  },
  "kinds": {
    "search": {
      "claude": "Grep",
      "omp": "grep",
      "mode": "deny",
      "replacements": [
        {
          "tool": "ctx_search",
          "servers": [
            "lean-ctx"
          ]
        }
      ]
    },
    "glob": {
      "claude": "Glob",
      "omp": "glob",
      "mode": "deny",
      "replacements": [
        {
          "tool": "ctx_glob",
          "servers": [
            "lean-ctx"
          ]
        }
      ]
    },
    "read": {
      "claude": "Read",
      "omp": "read",
      "mode": "nudge",
      "replacements": [
        {
          "tool": "ctx_read",
          "servers": [
            "lean-ctx"
          ]
        }
      ]
    },
    "shell": {
      "claude": "Bash",
      "omp": "bash",
      "mode": "nudge",
      "replacements": [
        {
          "tool": "ctx_shell",
          "servers": [
            "lean-ctx"
          ]
        },
        {
          "tool": "ctx_execute",
          "servers": [
            "lean-ctx",
            "context-mode"
          ]
        }
      ]
    }
  },
  "delegationExemptCases": {
    "exempt": [
      "docs/CHANGELOG.md",
      "README.md",
      ".atlas/run.json",
      "plugins/x/docs/guide.txt",
      "sub/.atlas/state.json"
    ],
    "code": [
      "src/app.py",
      "plugins/atlas/omp/index.ts",
      "docsite/app.ts",
      "notes.mdx"
    ]
  }
}
