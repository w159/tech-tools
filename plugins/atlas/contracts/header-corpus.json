{
  "_doc": "Shared header corpus. Each case: the reply text, whether the status header matches (match) and the phase it pins (phase, null when no match). hooks/test_atlas_contract.py runs it through the gate's parser and mod/contract-pattern.test.ts through the mod's, so both read a reply by the same rule: split on \\n only, first line that is not empty after stripping ASCII whitespace (space, tab, CR, VT, FF), stripped. Unicode separators (U+2028, U+0085, U+FEFF, U+00A0, FS-US) are neither line breaks nor whitespace: Python splitlines()/strip() and JavaScript trim() disagree on them, so neither is used.",
  "cases": [
    { "name": "plain", "text": "ATLAS | 🔧 implement | wiring the gate", "match": true, "phase": "implement" },
    { "name": "phase before glyph", "text": "ATLAS | implement 🔧 | wiring the gate", "match": true, "phase": "implement" },
    { "name": "n/m counter", "text": "ATLAS | 🔧 implement 3/5 | wiring the gate", "match": true, "phase": "implement" },
    { "name": "blocked", "text": "ATLAS | ⛔ blocked | stop gate open", "match": true, "phase": "blocked" },
    { "name": "leading blank line", "text": "\nATLAS | 🔧 implement | wiring the gate", "match": true, "phase": "implement" },
    { "name": "several leading blank lines and a body", "text": "\n  \n\nATLAS | 🏁 done | shipped\n\nbody line", "match": true, "phase": "done" },
    { "name": "leading spaces", "text": "   ATLAS | 🔧 implement | wiring the gate", "match": true, "phase": "implement" },
    { "name": "trailing spaces", "text": "ATLAS | 🔧 implement | wiring the gate   \nbody", "match": true, "phase": "implement" },
    { "name": "bold brand", "text": "**ATLAS** | 🔧 implement | wiring the gate", "match": true, "phase": "implement" },
    { "name": "bold brand with counter", "text": "**ATLAS** | ✅ verify 2/4 | running the suites", "match": true, "phase": "verify" },
    { "name": "bold brand after a blank line", "text": "\n**ATLAS** | 🔍 research | reading the gate", "match": true, "phase": "research" },
    { "name": "missing glyph", "text": "ATLAS | implement | wiring the gate", "match": false, "phase": null },
    { "name": "missing glyph, bold brand", "text": "**ATLAS** | implement | wiring the gate", "match": false, "phase": null },
    { "name": "wrong case phase", "text": "ATLAS | 🔧 Implement | wiring the gate", "match": false, "phase": null },
    { "name": "wrong case brand", "text": "Atlas | 🔧 implement | wiring the gate", "match": false, "phase": null },
    { "name": "half-bold brand", "text": "*ATLAS* | 🔧 implement | wiring the gate", "match": false, "phase": null },
    { "name": "no state", "text": "ATLAS | 🔧 implement |", "match": false, "phase": null },
    { "name": "header not on the first non-empty line", "text": "Starting now.\nATLAS | 🔧 implement | wiring the gate", "match": false, "phase": null },
    { "name": "header on the second line after a blank", "text": "\nSure.\nATLAS | 🔧 implement | wiring the gate", "match": false, "phase": null },
    { "name": "empty reply", "text": "", "match": false, "phase": null },
    { "name": "crlf line endings after a blank line", "text": "\r\nATLAS | 🔧 implement | wiring the gate\r\nbody", "match": true, "phase": "implement" },
    { "name": "crlf blank lines before the header", "text": "\r\n\r\nATLAS | 🏁 done | shipped", "match": true, "phase": "done" },
    { "name": "bare carriage return before the header", "text": "\rATLAS | 🔧 implement | x", "match": true, "phase": "implement" },
    { "name": "vertical tab before the header", "text": "\u000bATLAS | 🔧 implement | x", "match": true, "phase": "implement" },
    { "name": "vertical tab line then the header", "text": "\u000b\nATLAS | 🔍 research | x", "match": true, "phase": "research" },
    { "name": "form feed before the header", "text": "\u000cATLAS | 🔧 implement | x", "match": true, "phase": "implement" },
    { "name": "form feed line then the header", "text": "\u000c\nATLAS | ✅ verify | x", "match": true, "phase": "verify" },
    { "name": "vertical tab after the header is no line break", "text": "ATLAS | 🔧 implement | x\u000bbody", "match": true, "phase": "implement" },
    { "name": "line separator after other text is no line break", "text": "Sure.\u2028ATLAS | 🔧 implement | x", "match": false, "phase": null },
    { "name": "line separator before the header is not whitespace", "text": "\u2028ATLAS | 🔧 implement | x", "match": false, "phase": null },
    { "name": "line separator line then the header", "text": "\u2028\nATLAS | 🔧 implement | x", "match": false, "phase": null },
    { "name": "next line character before the header", "text": "\u0085ATLAS | 🔧 implement | x", "match": false, "phase": null },
    { "name": "byte order mark before the header", "text": "\ufeffATLAS | 🔧 implement | x", "match": false, "phase": null },
    { "name": "file separator before the header", "text": "\u001cATLAS | 🔧 implement | x", "match": false, "phase": null },
    { "name": "no-break space before the header", "text": "\u00a0ATLAS | 🔧 implement | x", "match": false, "phase": null }
  ]
