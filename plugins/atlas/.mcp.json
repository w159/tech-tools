{
  "mcpServers": {
    "auvik": {
      "command": "node",
      "args": [
        "--import",
        "${CLAUDE_PLUGIN_ROOT}/mcp/_env/load.mjs",
        "${CLAUDE_PLUGIN_ROOT}/mcp/auvik/server.mjs"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ATLAS_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env",
        "CFG_AUVIK_USERNAME": "${user_config.auvik_username}",
        "CFG_AUVIK_API_KEY": "${user_config.auvik_api_key}",
        "CFG_AUVIK_REGION": "${user_config.auvik_region}"
      }
    },
    "blumira": {
      "command": "node",
      "args": [
        "--import",
        "${CLAUDE_PLUGIN_ROOT}/mcp/_env/load.mjs",
        "${CLAUDE_PLUGIN_ROOT}/mcp/blumira/server.mjs"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ATLAS_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env",
        "CFG_BLUMIRA_JWT_TOKEN": "${user_config.blumira_jwt_token}",
        "CFG_BLUMIRA_CLIENT_ID": "${user_config.blumira_client_id}",
        "CFG_BLUMIRA_CLIENT_SECRET": "${user_config.blumira_client_secret}",
        "CFG_BLUMIRA_BASE_URL": "${user_config.blumira_base_url}"
      }
    },
    "cipp": {
      "command": "node",
      "args": [
        "--import",
        "${CLAUDE_PLUGIN_ROOT}/mcp/_env/load.mjs",
        "${CLAUDE_PLUGIN_ROOT}/mcp/cipp/server.mjs"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ATLAS_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env",
        "CFG_CIPP_BASE_URL": "${user_config.cipp_base_url}",
        "CFG_CIPP_API_KEY": "${user_config.cipp_api_key}",
        "CFG_CIPP_TENANT_ID": "${user_config.cipp_tenant_id}",
        "CFG_CIPP_CLIENT_ID": "${user_config.cipp_client_id}",
        "CFG_CIPP_CLIENT_SECRET": "${user_config.cipp_client_secret}"
      }
    },
    "connectwise": {
      "command": "node",
      "args": [
        "--import",
        "${CLAUDE_PLUGIN_ROOT}/mcp/_env/load.mjs",
        "${CLAUDE_PLUGIN_ROOT}/mcp/connectwise/server.mjs"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ATLAS_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env",
        "CFG_CW_MANAGE_COMPANY_ID": "${user_config.cw_manage_company_id}",
        "CFG_CW_MANAGE_PUBLIC_KEY": "${user_config.cw_manage_public_key}",
        "CFG_CW_MANAGE_PRIVATE_KEY": "${user_config.cw_manage_private_key}",
        "CFG_CW_MANAGE_CLIENT_ID": "${user_config.cw_manage_client_id}",
        "CFG_CW_MANAGE_URL": "${user_config.cw_manage_base_url}"
      }
    },
    "spanning": {
      "command": "node",
      "args": [
        "--import",
        "${CLAUDE_PLUGIN_ROOT}/mcp/_env/load.mjs",
        "${CLAUDE_PLUGIN_ROOT}/mcp/spanning/server.mjs"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ATLAS_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env",
        "CFG_SPANNING_ADMIN_EMAIL": "${user_config.spanning_admin_email}",
        "CFG_SPANNING_API_TOKEN": "${user_config.spanning_api_token}",
        "CFG_SPANNING_PLATFORM": "${user_config.spanning_platform}",
        "CFG_SPANNING_API_URL": "${user_config.spanning_api_url}"
      }
    },
    "falcon": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp/falcon",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp/_env/load.py",
        "falcon_mcp.server"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ATLAS_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env",
        "CFG_FALCON_CLIENT_ID": "${user_config.falcon_client_id}",
        "CFG_FALCON_CLIENT_SECRET": "${user_config.falcon_client_secret}",
        "CFG_FALCON_BASE_URL": "${user_config.falcon_base_url}",
        "CFG_FALCON_MEMBER_CID": "${user_config.falcon_member_cid}"
      }
    },
    "knowbe4": {
      "command": "node",
      "args": [
        "--import",
        "${CLAUDE_PLUGIN_ROOT}/mcp/_env/load.mjs",
        "${CLAUDE_PLUGIN_ROOT}/mcp/knowbe4/server.mjs"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ATLAS_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env",
        "CFG_KNOWBE4_API_KEY": "${user_config.knowbe4_api_key}",
        "CFG_KNOWBE4_REGION": "${user_config.knowbe4_region}",
        "CFG_KNOWBE4_BASE_URL": "${user_config.knowbe4_base_url}"
      }
    },
    "ninjaone": {
      "command": "node",
      "args": [
        "--import",
        "${CLAUDE_PLUGIN_ROOT}/mcp/_env/load.mjs",
        "${CLAUDE_PLUGIN_ROOT}/mcp/ninjaone/server.mjs"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ATLAS_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env",
        "CFG_NINJAONE_CLIENT_ID": "${user_config.ninjaone_client_id}",
        "CFG_NINJAONE_CLIENT_SECRET": "${user_config.ninjaone_client_secret}",
        "CFG_NINJAONE_REGION": "${user_config.ninjaone_region}",
        "CFG_NINJAONE_AUTH_MODE": "${user_config.ninjaone_auth_mode}",
        "CFG_NINJAONE_BASE_URL": "${user_config.ninjaone_base_url}"
      }
    },
    "paylocity": {
      "command": "node",
      "args": [
        "--import",
        "${CLAUDE_PLUGIN_ROOT}/mcp/_env/load.mjs",
        "${CLAUDE_PLUGIN_ROOT}/mcp/paylocity/server.mjs"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ATLAS_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env",
        "CFG_PAYLOCITY_CLIENT_ID": "${user_config.paylocity_client_id}",
        "CFG_PAYLOCITY_CLIENT_SECRET": "${user_config.paylocity_client_secret}",
        "CFG_PAYLOCITY_COMPANY_ID": "${user_config.paylocity_company_id}",
        "CFG_PAYLOCITY_BASE_URL": "${user_config.paylocity_base_url}",
        "CFG_PAYLOCITY_SANDBOX": "${user_config.paylocity_sandbox}"
      }
    },
    "threatlocker": {
      "command": "node",
      "args": [
        "--import",
        "${CLAUDE_PLUGIN_ROOT}/mcp/_env/load.mjs",
        "${CLAUDE_PLUGIN_ROOT}/mcp/threatlocker/server.mjs"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ATLAS_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env",
        "CFG_THREATLOCKER_API_KEY": "${user_config.threatlocker_api_key}",
        "CFG_THREATLOCKER_ORGANIZATION_ID": "${user_config.threatlocker_organization_id}",
        "CFG_THREATLOCKER_BASE_URL": "${user_config.threatlocker_base_url}"
      }
    },
    "vanta": {
      "command": "node",
      "args": [
        "--import",
        "${CLAUDE_PLUGIN_ROOT}/mcp/_env/load.mjs",
        "${CLAUDE_PLUGIN_ROOT}/mcp/vanta/server.mjs"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ATLAS_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env",
        "CFG_VANTA_CLIENT_ID": "${user_config.vanta_client_id}",
        "CFG_VANTA_CLIENT_SECRET": "${user_config.vanta_client_secret}",
        "CFG_VANTA_BASE_URL": "${user_config.vanta_base_url}"
      }
    }
  }
}
