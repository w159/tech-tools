// Gateway audit events from Container Apps console logs.
// Table ContainerAppConsoleLogs_CL, line in column Log_s (Microsoft Learn: Monitor logs in Azure Container Apps).
// If the environment sends logs to Azure Monitor resource-specific tables instead, use ContainerAppConsoleLogs and column Log.
// Edit the two lets below, or let the armada-enterprise skill substitute them.
let lookback = 7d;
let appName = "example-gateway";
ContainerAppConsoleLogs_CL
| where TimeGenerated > ago(lookback)
| where ContainerAppName_s == appName
| where Log_s startswith "{"
| extend e = parse_json(Log_s)
| where tostring(e.schema) == "mcp-gw.audit/1"
| where tostring(e.event) == "tool_call" and tostring(e.decision) == "deny"
| summarize denials = count(), connectors = make_set(tostring(e.connector), 20), reasons = make_set(tostring(e.reason), 20), last_denial = max(TimeGenerated)
    by person = coalesce(tostring(e.actor.email), tostring(e.actor.sub))
| order by denials desc
