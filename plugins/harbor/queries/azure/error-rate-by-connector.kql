// Gateway audit events from Container Apps console logs.
// Table ContainerAppConsoleLogs_CL, line in column Log_s (Microsoft Learn: Monitor logs in Azure Container Apps).
// If the environment sends logs to Azure Monitor resource-specific tables instead, use ContainerAppConsoleLogs and column Log.
// Edit the two lets below, or let the harbor-audit skill substitute them.
let lookback = 7d;
let appName = "example-gateway";
ContainerAppConsoleLogs_CL
| where TimeGenerated > ago(lookback)
| where ContainerAppName_s == appName
| where Log_s startswith "{"
| extend e = parse_json(Log_s)
| where tostring(e.schema) == "mcp-gw.audit/1"
| where tostring(e.event) == "tool_call" and tostring(e.decision) == "allow"
| summarize calls = count(),
    errors = countif(tostring(e.outcome) != "ok"),
    tool_errors = countif(tostring(e.outcome) == "tool_error"),
    backend_errors = countif(tostring(e.outcome) == "backend_error"),
    timeouts = countif(tostring(e.outcome) == "timeout"),
    p95_ms = percentile(todouble(e.duration_ms), 95)
    by connector = tostring(e.connector)
| extend error_rate_pct = round(100.0 * errors / calls, 2)
| order by error_rate_pct desc
