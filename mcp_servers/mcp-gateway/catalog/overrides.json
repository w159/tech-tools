  "blumira": { "compatRole": "Blumira", "stateful": true },
  "cipp": { "compatRole": "CIPP" },
  "connectwise": { "compatRole": "ConnectWise" },
  "falcon": { "compatRole": "Falcon", "command": "${BACKENDS_ROOT}/falcon/.venv/bin/falcon-mcp", "args": [] },
  "knowbe4": { "compatRole": "KnowBe4" },
  "ninjaone": { "compatRole": "NinjaOne" },
  "panos": { "compatRole": "PanOS" },
  "paylocity": { "compatRole": "Paylocity" },
  "sonicwall": { "compatRole": "SonicWall" },
  "spanning": { "compatRole": "Spanning" },
  "threatlocker": { "compatRole": "ThreatLocker" },
  "vanta": { "compatRole": "Vanta" }
}
