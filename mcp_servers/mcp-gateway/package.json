{
  "name": "mcp-gateway",
  "version": "0.2.0",
  "description": "Remote MCP gateway - OAuth resource server that aggregates vendor MCP stdio backends over Streamable HTTP with per-connector policy and audit",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --dir src",
    "gen-jwks": "node scripts/gen-jwks.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "jose": "^6.2.2",
    "oidc-provider": "9.12.2",
    "openid-client": "6.8.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
