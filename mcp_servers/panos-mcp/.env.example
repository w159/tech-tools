# PAN-OS host (Panorama or firewall). No scheme, no path. Required, no default:
# the base URL is the appliance itself.
PANOS_HOST=

# API key sent in the X-PAN-KEY header. Required unless PANOS_USERNAME and
# PANOS_PASSWORD are set and panos_keygen is used to mint one.
PANOS_API_KEY=

# Optional. Only used by panos_keygen to mint an API key from credentials.
PANOS_USERNAME=
PANOS_PASSWORD=

# Optional. Default managed-firewall serial when talking through Panorama.
PANOS_TARGET=

# Optional. Defaults to true. Set false only for a self-signed appliance.
PANOS_VERIFY_TLS=true

# Optional. REST API version path segment. Defaults to v11.1.
PANOS_REST_VERSION=v11.1
