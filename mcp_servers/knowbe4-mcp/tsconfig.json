{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "outDir": "./dist",
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": [
        "../_shared/*"
      ],
      "@modelcontextprotocol/sdk/*": [
        "./node_modules/@modelcontextprotocol/sdk/dist/esm/*"
      ],
      "zod": [
        "./node_modules/zod/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../_shared/response-shaper.ts",
    "../_shared/error-envelope.ts",
    "../_shared/base-url.ts",
    "../_shared/zod-shape.ts",
    "../_shared/mcp-server-kit.ts",
    "../_shared/server-entry.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
