# TypeSafe AI Jev System One - two independent providers, either one alone is
# enough. console.typesafe.ai may be temporarily inaccessible; OPENROUTER_API_KEY
# is a fully supported standalone path, not a fallback.

# Direct provider: key from console.typesafe.ai.
TYPESAFE_API_KEY=

# Optional. Leave blank to use the default (https://api.typesafe.ai/v1).
# Only set this for a staging or sovereign shard.
TYPESAFE_BASE_URL=

# OpenRouter provider: key from openrouter.ai, used only for the Jev
# Decisions path (POST https://openrouter.ai/api/alpha/decisions).
OPENROUTER_API_KEY=

# Optional. Leave blank to use the default (https://openrouter.ai/api).
OPENROUTER_BASE_URL=

# Optional OpenRouter attribution headers (HTTP-Referer / X-Title). Never
# required.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=

# Optional: typesafe | openrouter | auto. Leave blank for auto, which prefers
# TYPESAFE_API_KEY if set, else OPENROUTER_API_KEY.
TYPESAFE_PROVIDER=

# Optional model override. For provider typesafe, used verbatim (default
# jev-latest). For provider openrouter, a bare slug with no "/" is
# auto-prefixed with "~typesafe/" (default ~typesafe/jev-latest).
TYPESAFE_MODEL=
