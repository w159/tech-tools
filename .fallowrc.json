{
  "$schema": "https://fallow.dev/schema.json",
  "ignorePatterns": [
    "plugins/atlas/mcp/*/server.mjs",
    "plugins/atlas/mcp/*/http.mjs",
    "plugins/atlas/scripts/dashboard_ui/vendor/xterm/*",
    "plugins/atlas/scripts/dashboard_ui/css/*.css"
  ],
  "entry": [
    "mcp_servers/_shared/__tests__/*.test.ts",
    "plugins/atlas/mcp/_env/load.mjs",
    "plugins/atlas/mod/register.ts",
    "plugins/atlas/mod/band.tsx",
    "plugins/atlas/mod/pane/*.tsx",
    "plugins/atlas/mod/**/*.test.ts",
    "plugins/atlas/mod/**/*.test.tsx",
    "plugins/atlas/scripts/sprite_review.ts",
    "plugins/atlas/scripts/dashboard_ui/js/*.test.js",
    "plugins/atlas/scripts/dashboard_ui/js/pages/*.js",
    "plugins/atlas/scripts/dashboard_ui/js/theme-boot.js",
    "plugins/atlas/omp/*.test.ts",
    "plugins/atlas/omp/index.ts",
    "plugins/atlas/omp/test-env-preload.ts",
    "test-mcp-tools.mjs"
  ],
  "audit": {
    "deadCodeBaseline": "fallow-baselines/dead-code.json",
    "healthBaseline": "fallow-baselines/health.json",
    "dupesBaseline": "fallow-baselines/dupes.json"
  },
  "ignoreExports": [
    {
      "file": "mcp_servers/sonicwall-mcp/src/domains/*.ts",
      "exports": [
        "sessionHandler",
        "systemHandler",
        "configHandler",
        "objectsHandler",
        "policiesHandler",
        "interfacesHandler",
        "vpnHandler",
        "logsHandler",
        "genericHandler",
        "credentialIssuingTool"
      ]
    },
    {
      "file": "mcp_servers/panos-mcp/src/domains/*.ts",
      "exports": [
        "configHandler",
        "commitsHandler",
        "operationsHandler",
        "logsHandler",
        "reportsHandler",
        "filesHandler",
        "objectsHandler",
        "policiesHandler",
        "updatesHandler",
        "certificatesHandler"
      ]
    }
  ]
}
